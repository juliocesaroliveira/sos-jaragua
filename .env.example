# =============================================================================
# SOS Jaraguá — variáveis de ambiente (DESIGN.md §17)
# Copie para `.env.local` e preencha os valores reais. Nunca commitar `.env.local`.
# =============================================================================

# --- Postgres (Neon) ---------------------------------------------------------
# Conexão pooled — usada pelo runtime da aplicação (@neondatabase/serverless)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Conexão direta (sem PgBouncer) — usada por `drizzle-kit generate/migrate`
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# --- MongoDB Atlas (somente auditoria imutável — DB_SCHEMA.md §9) ------------
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/sos-jaragua?retryWrites=true&w=majority"

# --- better-auth -------------------------------------------------------------
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Login social (DESIGN.md §6.1 — Instagram fora do MVP) -------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- E-mail transacional -----------------------------------------------------
RESEND_API_KEY=""
# Remetente usado nos e-mails transacionais (domínio verificado no Resend)
RESEND_FROM="SOS Jaraguá <nao-responda@exemplo.com.br>"

# --- WhatsApp (DESIGN.md §12, specs/024-notificacoes-whatsapp) ---------------
# Sem ACCESS_TOKEN ou PHONE_NUMBER_ID o canal fica "não configurado": sino e e-mail
# seguem normais e os envios de WhatsApp são registrados como não enviados.
# Token permanente de usuário do sistema da Meta (whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=""
# ID do número de envio na Cloud API (WhatsApp Manager → API Setup)
WHATSAPP_PHONE_NUMBER_ID=""
# Segredo do app Meta — valida a assinatura X-Hub-Signature-256 do webhook
WHATSAPP_APP_SECRET=""
# Token livre, o mesmo informado ao cadastrar o webhook na Meta
WHATSAPP_VERIFY_TOKEN=""
# Versão da Graph API usada nas chamadas
WHATSAPP_GRAPH_VERSION="v23.0"
# Idioma em que os modelos de mensagem foram aprovados
WHATSAPP_TEMPLATE_LANG="pt_BR"

# --- Vercel Cron (DESIGN.md §12) ---------------------------------------------
# Protege GET /api/cron/* via header `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=""

# --- Proteção de dados sensíveis (LGPD — feature 025) ------------------------
# Chave mestra da criptografia a nível de campo de `cpf`, `cep` e `data_nascimento`.
# A aplicação RECUSA inicializar sem ela (Princípio IV da Constituição).
# Gere com: openssl rand -base64 32  (exatamente 32 bytes)
# Trocar esta chave torna ilegíveis os dados já gravados — ver research.md D1.
DADOS_SENSIVEIS_CHAVE=""

# --- Sessão de staff (DESIGN.md §6.3) ----------------------------------------
# Timeout de inatividade em minutos para membro_defesa_civil/coordenador
STAFF_INACTIVITY_TIMEOUT_MINUTES="15"

# --- Alertas de coordenador (BRD §6, NOT-08) ---------------------------------
# Os três valores são PROVISÓRIOS até confirmação da Defesa Civil
# (spec/ROTEIRO_PRODUCAO.md, passo 7). Em variável de ambiente para ajuste sem deploy.
# Nº de candidaturas pendentes que dispara `cadastros_acumulados` (provisório)
ALERTA_CADASTROS_PENDENTES="10"
# Mínimo de segurança PADRÃO, usado pelos itens sem mínimo próprio em
# `item.estoque_minimo`; dispara `estoque_critico` (provisório)
ALERTA_ESTOQUE_MINIMO="5"
# % de déficit de capacidade que dispara `deficit_atendimento` (provisório)
ALERTA_DEFICIT_PERCENTUAL="80"
